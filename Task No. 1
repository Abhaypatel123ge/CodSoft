#include <iostream>
#include <cstdlib>
#include <ctime>
using namespace std;

int main() {
    srand(time(0));

    int number = rand() % 100 + 1;  // Random number from 1 to 100
    int guess;

    cout << "Guess the number between 1 and 100: ";

    while (true) {
        cin >> guess;

        if (guess > number) {
            cout << "Too high! Try again: ";
        }
        else if (guess < number) {
            cout << "Too low! Try again: ";
        }
        else {
            cout << "Correct! You guessed the number." << endl;
            break;
        }
    }

    return 0;
}

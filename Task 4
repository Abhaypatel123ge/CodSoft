
#include <iostream>
#include <vector>
#include <string>
using namespace std;

// Add a task
void addTask(vector<string>& tasks, vector<bool>& completed) {
    string task;

    cout << "Enter task: ";
    cin.ignore();
    getline(cin, task);

    tasks.push_back(task);
    completed.push_back(false);

    cout << "Task added successfully!\n";
}

// View all tasks
void viewTasks(const vector<string>& tasks, const vector<bool>& completed) {

    if (tasks.empty()) {
        cout << "No tasks available.\n";
        return;
    }

    cout << "\n===== TO-DO LIST =====\n";

    for (int i = 0; i < tasks.size(); i++) {
        cout << i + 1 << ". " << tasks[i];

        if (completed[i])
            cout << " [Completed]\n";
        else
            cout << " [Pending]\n";
    }
}

// Mark a task as completed
void markCompleted(vector<bool>& completed, int taskNumber) {

    if (taskNumber < 1 || taskNumber > completed.size()) {
        cout << "Invalid task number!\n";
        return;
    }

    completed[taskNumber - 1] = true;

    cout << "Task marked as completed!\n";
}

// Remove a task
void removeTask(vector<string>& tasks,
                vector<bool>& completed,
                int taskNumber) {

    if (taskNumber < 1 || taskNumber > tasks.size()) {
        cout << "Invalid task number!\n";
        return;
    }

    tasks.erase(tasks.begin() + taskNumber - 1);
    completed.erase(completed.begin() + taskNumber - 1);

    cout << "Task removed successfully!\n";
}

int main() {

    vector<string> tasks;
    vector<bool> completed;

    int choice;

    do {
        cout << "\n===== TO-DO LIST MANAGER =====\n";
        cout << "1. Add Task\n";
        cout << "2. View Tasks\n";
        cout << "3. Mark Task as Completed\n";
        cout << "4. Remove Task\n";
        cout << "5. Exit\n";

        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice) {

            case 1:
                addTask(tasks, completed);
                break;

            case 2:
                viewTasks(tasks, completed);
                break;

            case 3: {
                int taskNumber;

                viewTasks(tasks, completed);

                cout << "Enter task number to complete: ";
                cin >> taskNumber;

                markCompleted(completed, taskNumber);
                break;
            }

            case 4: {
                int taskNumber;

                viewTasks(tasks, completed);

                cout << "Enter task number to remove: ";
                cin >> taskNumber;

                removeTask(tasks, completed, taskNumber);
                break;
            }

            case 5:
                cout << "Exiting To-Do List Manager...\n";
                break;

            default:
                cout << "Invalid choice! Try again.\n";
        }

    } while (choice != 5);

    return 0;
}

